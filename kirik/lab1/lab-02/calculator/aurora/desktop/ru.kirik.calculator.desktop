# Идентификатор приложения и разрешения. Оболочка связывает имя/иконку с запуском и разрешениями
# песочницы. Имена ресурсов должны совпадать с идентификатором приложения.
# Name — отображаемое имя; Exec — команда запуска установленного бинарного файла.
[Desktop Entry]
# Application обозначает запускаемое приложение desktop-файла.
Type=Application
# Технический идентификатор RPM/приложения; отличается от пользовательского названия.
Name=Калькулятор
Comment=Калькулятор через WebSocket
# Имя PNG без расширения. Оболочка ищет его в стандартной hicolor-теме.
Icon=ru.kirik.calculator
# Установленная команда запуска, а не путь к исходникам на компьютере.
Exec=/usr/bin/ru.kirik.calculator
# Тип GUI сообщает оболочке способ запуска приложения.
X-Nemo-Application-Type=silica-qt5

# OrganizationName.ApplicationName обязаны совпадать с именем RPM-пакета.
# Internet разрешает соединение с Python-сервером в песочнице приложения.
[X-Application]
# Разрешения песочницы; Internet требуется для сети, включая локальные соединения.
Permissions=Internet
# Пространство имён приложения, влияющее на хранение настроек и разделение данных.
OrganizationName=ru.kirik
# Имя внутри организации: разные клиенты должны иметь изолированные настройки.
ApplicationName=calculator
